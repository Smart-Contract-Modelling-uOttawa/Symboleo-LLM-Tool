# Copy this file to .env and fill in your keys — never commit .env

# LLM Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
COHERE_API_KEY=your_cohere_key_here

# LangSmith (only needed if observability.langsmith.enabled: true in config)
LANGSMITH_API_KEY=your_langsmith_key_here

# API CORS allowed origins — comma-separated (default: http://localhost:5173)
# Only set this if your frontend runs on a non-standard origin
# CORS_ORIGINS=http://localhost:5173

# Model-compatibility data source. The app pins this to True by default (bundled,
# package-versioned data — deterministic and offline-safe). Set to False to fetch
# the latest model list from GitHub at startup. NOTE: this is read at litellm
# import, before .env is loaded — for the CLI it must be a real exported env var
# (the Docker API reads it from this file at the OS level, so it works there).
# LITELLM_LOCAL_MODEL_COST_MAP=False

# Few-shot example corpus location (default: ./examples, resolved against the
# working directory). Set this to run the CLI from outside the project root.
# SYMBOLEO_EXAMPLES_DIR=/path/to/examples
