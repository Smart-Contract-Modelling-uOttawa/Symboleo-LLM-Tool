# Copy this file to .env and fill in your keys — never commit .env

# LLM Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# LangSmith (only needed if observability.langsmith.enabled: true in config)
LANGSMITH_API_KEY=your_langsmith_key_here

# API CORS allowed origins — comma-separated (default: http://localhost:5173)
# Only set this if your frontend runs on a non-standard origin
# CORS_ORIGINS=http://localhost:5173
